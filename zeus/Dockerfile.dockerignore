# The build context is the top of the repository; BuildKit reads this file because it sits next
# to zeus/Dockerfile. Only what the image needs goes in: the code, the requirements and the
# license. Docs, tests, the website and .git stay out, and so do the two Docker files.
*
!LICENSE
!requirements.txt
!zeus
zeus/Dockerfile
zeus/Dockerfile.dockerignore

# A checkout that has been run has runtime links under zeus/ (into ~/.zeus-terminal/runtime),
# bytecode and maybe node_modules; none of it goes into the image.
zeus/data
zeus/options_analyzer/data
zeus/trade_journal/data
zeus/pre_trade_checkup/data
zeus/stock_picker/data
zeus/eod_crawler/data_eod
zeus/eod_crawler/logs
zeus/barchart/downloads
zeus/barchart/snapshots
zeus/benzinga_digest/digests
zeus/benzinga_digest/ai_summary
zeus/benzinga_digest/pivot_summary
zeus/benzinga_digest/finviz_ai
zeus/trading_assistant/data
zeus/trading_assistant/reports
zeus/winrate_scanner/data
zeus/benzinga/data
**/__pycache__
**/*.pyc
**/node_modules
**/.DS_Store

# credentials, in case someone dropped a file into the code folder (same list as .gitignore)
**/.env
**/.env.*
**/*.env
**/keys.env
**/*credentials*
**/*cookies*.json
**/*cookie*.txt
**/*token*.json
**/*token*.txt
**/*secret*
**/password*
**/client_id.txt
**/client_secret.txt
**/refresh_token.txt
**/data_apikey.txt
**/*.pem
**/*.key
**/*.p12
**/trades_raw.json
**/*.parquet
**/*.zst
**/*.jsonl
**/*.sqlite
**/*.db
**/*.log
